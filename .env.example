# Copy this file to `.env` and fill in your own keys. `.env` is git-ignored
# and never committed — the engine runs fine without keys via the keyless
# provider fallbacks (Open-Meteo, OpenSky, adsb.lol) and simulation.
# Live wind vectors & storm cells (optional — primary weather provider).
OPENWEATHER_API_KEY=
# Legacy aviation-traffic key (unused by the current realtime chain, kept for reference).
AVIATIONSTACK_API_KEY=
# Optional CARTO Voyager tile key (keyless CDN is used when empty).
CARTO_API_KEY=
